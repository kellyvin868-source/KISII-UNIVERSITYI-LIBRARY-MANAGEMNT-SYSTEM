NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/kisii-library
JWT_SECRET_KEY=replace-with-a-long-random-secret
OVERDUE_FINE_PER_DAY=10

# OpenRouter Nemotron smart catalog search and assistant
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# University student registry (expected response: {"verified":true|false})
STUDENT_REGISTRY_BASE_URL=
STUDENT_REGISTRY_API_KEY=

# M-Pesa Daraja (callback URL must be publicly reachable and include ?token=<shared-token>)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Gmail SMTP (use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM=your-address@gmail.com
SMTP_SECURE=false

# Africa's Talking SMS
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
